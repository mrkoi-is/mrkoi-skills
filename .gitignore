# macOS
.DS_Store

# Syncthing / cloud-sync conflict copies
.sync-conflict-*

# Local recovery / corrupted git directories
.git.corrupt-*

# Tessl auto-generated tile files (regenerated on every publish)
*/tile.json

# Local Claude Code project settings
.claude/settings.local.json

# Local agent instructions; public maintenance rules are explicitly included below
CLAUDE.md
AGENTS.md

# …except eval fixtures: those CLAUDE.md/AGENTS.md files are test material, not secrets
!*/evals/fixtures/**/CLAUDE.md
!*/evals/fixtures/**/AGENTS.md

# Public maintenance instructions for this fork
!/AGENTS.md

# Local artifacts and Python environments
.venv/
__pycache__/
*.pyc
.pytest_cache/
output/
.aihot-actor-id
.aihot-actor-disabled
